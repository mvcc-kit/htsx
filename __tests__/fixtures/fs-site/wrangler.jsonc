{
  "name": "fs-site",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": { "binding": "ASSETS", "directory": ".htsx/cloudflare" },
  "vars": { "SAUDACAO": "Olá do wrangler.jsonc" },
  "d1_databases": [{ "binding": "DB", "database_name": "notes", "database_id": "local" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "anexos" }],
  "kv_namespaces": [{ "binding": "KV", "id": "local" }],
  "durable_objects": { "bindings": [{ "name": "CONTADOR", "class_name": "Contador" }] },
}
