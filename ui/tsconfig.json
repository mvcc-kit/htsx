{
  // Fora do workspace do monorepo, htsx aponta para a pasta acima.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "htsx": ["../index.ts"],
      "htsx/*": ["../*"],
      "htsx/jsx-runtime": ["../src/jsx-runtime.ts"],
      "htsx/jsx-dev-runtime": ["../src/jsx-runtime.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../jsx.d.ts"]
}
